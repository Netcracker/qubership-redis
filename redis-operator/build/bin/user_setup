#!/bin/sh
set -x

# ensure $HOME exists and is accessible by group 0 (we don't know what the runtime UID will be)
mkdir -p ${HOME}
chown ${USER_UID}:0 ${HOME}
chmod ug+rwx ${HOME}

# pre-bake the passwd entry for USER_UID so that getpass works under
# readOnlyRootFilesystem: true (no runtime write to /etc/passwd needed)
echo "${USER_NAME:-dbaas-redis-operator}:x:${USER_UID}:0:${USER_NAME:-dbaas-redis-operator} user:${HOME}:/sbin/nologin" >> /etc/passwd

# no need for this script to remain in the image after running
rm $0
